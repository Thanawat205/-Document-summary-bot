    {
      "parameters": {
        "jsCode": "// ดึงข้อความสรุปจาก Gemini (อ้างอิงจาก path เดิมของคุณ)\nlet text = $input.item.json.candidates[0].content.parts[0].text;\n\n// ตั้งค่าความยาวสูงสุดต่อ 1 ข้อความ (ตั้งไว้ 1900 เพื่อความปลอดภัย ไม่ให้ชน 2000)\nlet maxLength = 1900; \nlet chunks = [];\n\n// หั่นข้อความเป็นท่อนๆ\nfor (let i = 0; i < text.length; i += maxLength) {\n  chunks.push(text.substring(i, i + maxLength));\n}\n\n// ส่งข้อความแต่ละท่อนออกไปเป็น Item ย่อยๆ ให้ n8n ทำงานต่อ\nreturn chunks.map(chunk => {\n  return {\n    json: {\n      messageChunk: chunk\n    }\n  };\n});"
      },
