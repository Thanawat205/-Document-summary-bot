        "jsonBody": "={{\nJSON.stringify({\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"ช่วยสรุปเนื้อหาสำคัญจากข้อความนี้เป็นภาษาไทยให้หน่อย : \" + $node[\"Extract from File\"].json[\"text\"]\n        }\n      ]\n    }\n  ]\n})\n}}",
